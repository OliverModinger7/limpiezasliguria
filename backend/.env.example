# Puerto donde escucha el servicio (detrás del proxy/reverse-proxy de DonWeb).
# 3000 y 3001 ya están ocupados en el servidor por el proyecto voz-en-letras.
PORT=3003

# Orígenes permitidos para CORS, separados por coma.
# Debe incluir el dominio real donde vive el frontend en producción.
FRONTEND_ORIGIN=http://localhost:3002,https://limpiezasliguria.cl,https://www.limpiezasliguria.cl

# Clave compartida que el frontend debe enviar en el header "x-api-key"
# para poder usar el endpoint /contact. Genera una cadena larga y aleatoria.
INTERNAL_API_KEY=

# SMTP (Nodemailer) — credenciales del correo del dominio en DonWeb
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remitente y destinatario de las solicitudes de cotización
MAIL_FROM=no-reply@limpiezasliguria.cl
MAIL_TO=contacto@limpiezasliguria.cl
