# MongoDB Atlas — usa el mismo clúster que voz-en-letras pero con su PROPIA
# base de datos y, si es posible, un usuario de Mongo dedicado (Atlas > Database
# Access > Add New Database User) con permisos solo sobre esa base.
# Reemplaza <user>, <password> y el nombre de la base al final de la URI.
MONGO_URI=mongodb+srv://<user>:<password>@clustertst.cb6tmee.mongodb.net/limpiezasliguria

# Puerto donde escucha el servicio (detrás del proxy/reverse-proxy de DonWeb).
# 3000 y 3001 ya están ocupados en el servidor por el proyecto voz-en-letras.
PORT=3003

# Orígenes permitidos para CORS, separados por coma.
# Debe incluir el dominio real donde vive el frontend en producción.
FRONTEND_ORIGIN=http://localhost:3002,https://limpiezasliguria.cl,https://www.limpiezasliguria.cl

# Clave compartida que el frontend debe enviar en el header "x-api-key"
# para poder usar el endpoint /contact. Genera una cadena larga y aleatoria,
# por ejemplo con: openssl rand -hex 32
INTERNAL_API_KEY=

# SMTP (Nodemailer) — credenciales de la casilla contacto@limpiezasliguria.cl
# (revisa el panel de DonWeb/Ferozo para el host exacto asignado a este dominio;
# probablemente algo como aXXXXXXX.ferozo.com, igual que en vozenletras.cl)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contacto@limpiezasliguria.cl
SMTP_PASSWORD=

# Remitente y destinatario de las solicitudes de cotización
MAIL_FROM=no-reply@limpiezasliguria.cl
MAIL_TO=contacto@limpiezasliguria.cl
