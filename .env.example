# Resend (https://resend.com) — used by src/app/api/contact/route.ts
# to email form submissions to contacto@limpiezasliguria.cl
RESEND_API_KEY=

# Optional: sender address. Must be on a domain verified in Resend.
# Defaults to onboarding@resend.dev (Resend's shared test sender) if unset.
RESEND_FROM_EMAIL=
