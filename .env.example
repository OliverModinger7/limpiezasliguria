# Usados por src/app/api/contact/route.ts (Route Handler, corre en el servidor
# de Next.js, nunca se envían al navegador del visitante).

# URL del endpoint /contact del backend NestJS.
CONTACT_API_URL=https://api.limpiezasliguria.cl/contact

# Debe ser exactamente el mismo valor que INTERNAL_API_KEY en backend/.env
CONTACT_API_KEY=
